# Run `uv run recipe-assistant init` to generate .env with a private API token.
RECIPE_ASSISTANT_TOKEN=replace-with-a-long-random-token
RECIPE_ASSISTANT_HOST=127.0.0.1
RECIPE_ASSISTANT_PORT=8765
# Pantry staples remain visible but unchecked in shopping previews.
# RECIPE_ASSISTANT_PANTRY_STAPLES='["olive oil"]'
# Optional; default is the current user's Recipe Keeper database:
# RECIPE_KEEPER_DB=/absolute/path/to/RecipeKeeper.db

# Cloud mode: run `uv run recipe-assistant configure-cloud` first.
# RECIPE_ASSISTANT_BACKEND=cloud
# RECIPE_KEEPER_CREDENTIALS_FILE=local-data/cloud-credentials.json
# RECIPE_KEEPER_CACHE=local-data/cloud-cache.db
# RECIPE_KEEPER_POLL_SECONDS=300
# Instead of a credentials file, both RECIPE_KEEPER_EMAIL and
# RECIPE_KEEPER_PASSWORD may be supplied by the deployment's secret manager.
